(version 1)
# AUTO-GENERATED by boardgen/14_design_rules.py — do NOT hand-edit.
# Source: third_party/kicad-jlcpcb-dru (tinfever, adapted).
# Profile: JLCPCB 2-layer, 1oz copper, standard service.

# --- Minimum trace width and clearance (2-layer, 1oz) ---
# 0.20 mm floor: JLCPCB's DFM scanner warns below ~0.20 mm even
# though the raw fab capability is 0.127 mm. Routing targets
# 0.25 mm signal / 0.40-0.50 mm power, all clear of this floor.
(rule "Minimum Trace Width and Spacing"
	(constraint track_width (min 0.20mm))
	(constraint clearance (min 0.20mm))
	(condition "A.Type == 'track'"))

# --- Drill / hole size (mechanical NPTH range) ---
(rule "drill hole size (mechanical)"
	(constraint hole_size (min 0.15mm) (max 6.3mm)))

# --- Via diameter and hole size (2-layer standard) ---
# 0.70 mm diameter / 0.30 mm drill = 0.20 mm annular ring. JLCPCB
# accepts 0.15 mm annular but the DFM scanner emits yield hints
# below 0.20 mm; 0.70/0.30 clears it with no warning.
(rule "Minimum Via Diameter and Hole Size"
	(constraint hole_size (min 0.3mm))
	(constraint via_diameter (min 0.70mm))
	(constraint annular_width (min 0.20mm))
	(constraint disallow buried_via)
	(condition "A.Type == 'via'"))

# --- PTH and NPTH pad size ---
(rule "PTH Hole Size"
	(constraint hole_size (min 0.2mm) (max 6.35mm))
	(condition "A.Type != 'Via' && A.isPlated()"))

(rule "Minimum Non-plated Hole Size"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'pad' && !A.isPlated()"))

(rule "Pad Size"
	(constraint hole_size (min 0.5mm))
	(constraint annular_width (min 0.25mm))
	(condition "A.Type == 'Pad' && A.isPlated()"))

# Domain-specific exception: fine-pitch hand-solder THT headers
# (P1.27mm) carry annular 0.175 mm in KiCad stock library — this
# is acceptable for HAND SOLDER (J4 LD2410 connector). JLCPCB
# documents 0.15 mm as the absolute 2-layer PTH minimum; the
# 0.25 mm rule above protects auto-assembly tape-feeder tolerance
# which does NOT apply to hand-solder operations. J4 is in
# THT_REFERENCES (pipeline/_project.py) — flagged for hand-
# solder by exclusion from JLCPCB SMT.
(rule "Fine-Pitch Hand-Solder PTH Annular"
	(constraint annular_width (min 0.15mm))
	(condition "A.Type == 'Pad' && A.isPlated() && A.Parent.Reference == 'J4'"))

(rule "Min. Plated Slot Width"
	(constraint hole_size (min 0.5mm))
	(condition "(A.Hole_Size_X != A.Hole_Size_Y) && A.isPlated()"))

(rule "Min. Non-Plated Slot Width"
	(constraint hole_size (min 1.0mm))
	(condition "(A.Hole_Size_X != A.Hole_Size_Y) && !A.isPlated()"))

# --- Hole-to-hole and pad-to-pad clearances ---
(rule "hole to hole clearance (different nets)"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Net != B.Net"))

(rule "via to track clearance"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Type == 'via' && B.Type == 'track'"))

(rule "via to via clearance (same nets)"
	(constraint hole_to_hole (min 0.254mm))
	(condition "A.Type == 'via' && B.Type == A.Type && A.Net == B.Net"))

(rule "pad to pad clearance (with hole, different nets)"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Type == 'pad' && B.Type == A.Type && A.Net != B.Net"))

(rule "pad to pad clearance (without hole, different nets)"
	(constraint clearance (min 0.127mm))
	(condition "A.Type == 'Pad' && B.Type == 'Pad'"))

(rule "NPTH to Track clearance"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track'"))

(rule "NPTH with copper around"
	(constraint hole_clearance (min 0.20mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type != 'track'"))

(rule "PTH to Track clearance"
	(constraint hole_clearance (min 0.33mm))
	(condition "A.isPlated() && A.Type != 'Via' && B.Type == 'track'"))

(rule "Pad to Track clearance"
	(constraint clearance (min 0.2mm))
	(condition "A.isPlated() && A.Type != 'Via' && B.Type == 'track'"))

# --- Board edge clearance (default routed) ---
(rule "Trace to Outline"
	(constraint edge_clearance (min 0.3mm))
	(condition "A.Type == 'track'"))

# --- Silkscreen text and pad-to-silk clearance ---
(rule "Minimum Text"
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1mm))
	(layer "?.Silkscreen"))

# NOTE: upstream had a 'Pad to Silkscreen' rule at 0.14 mm. We do
# NOT emit it here because every KiCad stock library cap footprint
# (0402/0603/0805) sits at 0.10 mm by convention — adding the rule
# would produce ~28 systematic violations on every BOM revision,
# none of which JLCPCB actually rejects. Pre-`.kicad_dru` DRC did
# not enforce silk clearance either, so omitting matches prior
# behaviour; the `.kicad_pro` min_silk_clearance (0.15) still
# applies for any custom silk geometry we emit in boardgen.
