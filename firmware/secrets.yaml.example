# OAS — ESPHome secrets template
#
# Copy this file to `secrets.yaml` next to `esphome/oas.yaml` and fill in real values.
# `secrets.yaml` is gitignored and MUST NEVER be committed.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Optional fallback hotspot — used when the configured WiFi is unreachable.
ap_password: "set-a-long-fallback-password"

# Home Assistant native API encryption key.
# Generate with: `esphome wizard` or `openssl rand -base64 32`
api_encryption_key: "base64-encoded-32-byte-key"

# OTA password — required by ESPHome for over-the-air updates.
ota_password: "set-a-long-ota-password"
