# =============================================================================
# OAS — ESPHome secrets template
# =============================================================================
#
# Copy this file to `secrets.yaml` next to `esphome/oas.yaml` and fill in
# real values. `secrets.yaml` is gitignored and MUST NEVER be committed.
#
# The same secrets.yaml can be shared across every OAS device in a
# deployment — per-device identity lives in substitutions, not secrets.
# =============================================================================

# ---------------------------------------------------------------------------
# WiFi credentials — the network every OAS device joins.
# ---------------------------------------------------------------------------
wifi_ssid: "YourSSID"
wifi_password: "YourPassword"

# ---------------------------------------------------------------------------
# AP fallback hotspot password.
# ---------------------------------------------------------------------------
# Used when the configured WiFi is unreachable. The device exposes
# `OAS-<device_id>-Setup` as an open AP gated by this PSK; a captive
# portal lets you re-enter WiFi credentials without re-flashing.
# Minimum 8 characters (WPA2 requirement).
ap_password: "ChangeMeAtFirstFlash"

# ---------------------------------------------------------------------------
# Home Assistant native API encryption key.
# ---------------------------------------------------------------------------
# 32 random bytes, base64-encoded. Generate one of these ways:
#   - esphome --encryption-key
#   - openssl rand -base64 32
#   - python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_encryption_key: "generate via 'esphome --encryption-key' or random 32 bytes base64"

# ---------------------------------------------------------------------------
# OTA password — required by ESPHome for over-the-air firmware updates.
# ---------------------------------------------------------------------------
# Use any strong password. Lost OTA password = re-flash via USB-C.
ota_password: "any-strong-password"
