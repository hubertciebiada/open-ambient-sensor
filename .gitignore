# OS specific ########
.DS_Store
Thumbs.db
desktop.ini

# secrets ########
secrets.yaml
**/secrets.yaml

# third-party manufacturer files (kept locally, not redistributable) ########
hardware/case/*.dxf
hardware/case/*-datasheet.pdf
hardware/case/manufacturer-*.step
hardware/case/manufacturer-*.stp
hardware/case/manufacturer-*.pdf

# build artifacts ########
**/build/
**/.cache/
**/__pycache__/
*.bak
*-backups/

# KiCad ########
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
~*.lck
_autosave-*

# Local KiCad reports/exports (regenerable, not source-of-truth)
hardware/kicad/drc.json
hardware/kicad/erc.json
hardware/kicad/*.svg
hardware/kicad/*.pdf
hardware/kicad/*.rpt

# Freerouting intermediate artifacts (DSN export → autorouter → SES import roundtrip)
hardware/kicad/*.dsn
hardware/kicad/*.ses
hardware/kicad/oas_drc_violations.json
# Inside renders/: PNGs and SVGs are committed as visual changelog,
# but DRC/ERC text reports (prefixed `_`) are not.
hardware/kicad/renders/_*

# ESPHome ########
.esphome/
firmware/esphome/.esphome/

# Editors ########
.vscode/
.idea/
.history/
*.swp
*~

