# OS specific ########
.DS_Store
Thumbs.db
desktop.ini

# secrets ########
**/secrets.yaml

# third-party manufacturer files (kept locally, not redistributable) ########
hardware/case/*.dxf
hardware/case/*-datasheet.pdf
hardware/case/manufacturer-*.step
hardware/case/manufacturer-*.stp
hardware/case/manufacturer-*.pdf

# build artifacts ########
**/build/
**/.cache/
**/__pycache__/
*.bak

# KiCad ########
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
~*.lck
_autosave-*

# KiCad MCP-tool backups (timestamped safety copies)
hardware/kicad/.mcp-backups/

# Local KiCad reports/exports (regenerable, not source-of-truth)
hardware/kicad/drc.json
hardware/kicad/erc.json
hardware/kicad/*.svg
hardware/kicad/*.pdf
hardware/kicad/*.rpt

# Freerouting intermediate artifacts (DSN export → autorouter → SES import roundtrip)
hardware/kicad/*.dsn
hardware/kicad/*.ses
hardware/kicad/oas_drc_violations.json
# Inside renders/: PNGs and SVGs are committed as visual changelog,
# but DRC/ERC text reports (prefixed `_`) are not.
hardware/kicad/renders/_*
hardware/kicad/renders/*.log

# Production gerber export (regenerable from generate.py via export_production.py;
# never source-of-truth — a specific snapshot may be committed manually when
# sending to fab, but day-to-day regenerations should not appear in git diff)
hardware/gerbers/*.gtl
hardware/gerbers/*.gbl
hardware/gerbers/*.gts
hardware/gerbers/*.gbs
hardware/gerbers/*.gto
hardware/gerbers/*.gbo
hardware/gerbers/*.gtp
hardware/gerbers/*.gbp
hardware/gerbers/*.gm1
hardware/gerbers/*.gbrjob
hardware/gerbers/*.drl
hardware/gerbers/*-drl_map.pdf
hardware/gerbers/*-pos.csv
hardware/gerbers/oas-bom.csv
hardware/gerbers/oas-jlcpcb.zip

# ESPHome ########
.esphome/
firmware/esphome/.esphome/

# Editors ########
.vscode/
.idea/
.history/
*.swp
*~

# Playwright MCP / DFM live-upload temp artifacts ########
# anchored + global pair (bare `.playwright-mcp/` proved ineffective)
/.playwright-mcp/
**/.playwright-mcp/
*.kicad_pcb.tmp
*.kicad_pro.tmp

# Screenshots, scratch ########
Zrzut*.png
# widened from screenshot*.png — catches suffix patterns (botland-...-screenshot.png etc.)
*screenshot*.png
# session scratch renders + previews
led-preview*.png
*-preview*.png
*.scratch

# Cleanup audit reports (internal working docs, not project documentation)
_cleanup-reports/

# KiCad netlist exports (temporary, derived from .kicad_sch via kicad-cli)
*.net
_tmp_netlist_audit.net
_audit_*.net

# Freerouting tool (downloaded locally, not redistributable)
freerouting.jar
hardware/kicad/freerouting.jar
hardware/kicad/freerouting.json
hardware/kicad/freerouting.log

