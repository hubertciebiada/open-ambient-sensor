# OS specific ########
.DS_Store
Thumbs.db
desktop.ini

# secrets ########
**/secrets.yaml
.env
*.env
*.pem
*.key
id_rsa*
*.crt

# build artifacts ########
**/build/
**/.cache/
**/__pycache__/

# Temp / scratch directories (auto-downloaded models, cached binaries:
# .tmp/spice/ for ngspice + LM2596 PSpice model, .tmp/freerouting/ for
# Freerouting JAR when a routing rework is needed, .tmp/jlcparts/ for
# the JLCPCB component SQLite cache rebuilt by stage 34).
/.tmp/

# KiCad ########
*.kicad_prl
# editor lock files (KiCad writes ~<project>.kicad_pro.lck while open)
*.lck

# Local KiCad reports/exports (regenerable, not source-of-truth)
hardware/kicad/*.svg
hardware/kicad/*.pdf
hardware/kicad/*.rpt

# Freerouting intermediate artifacts (DSN export → autorouter → SES import roundtrip)
hardware/kicad/*.dsn
hardware/kicad/*.ses
hardware/kicad/oas_drc_violations.json
# Inside renders/: PNGs and SVGs are committed as visual changelog,
# but DRC/ERC text reports (prefixed `_`) are not.
hardware/renders/_*
hardware/renders/*.log

# Intermediate fab data (raw gerbers + drill + drill_map PDFs) lives in
# hardware/build/gerbers/. Already covered by the generic **/build/ rule
# above; this line is for explicitness — production output for a given
# vendor lives under hardware/output/<vendor>/ (committed: ZIP + BOM +
# CPL top + CPL bottom — exactly 4 files per vendor).
hardware/build/

# ESPHome ########
.esphome/
firmware/esphome/.esphome/

# Editors ########
.vscode/
.idea/
.history/
*.swp
*~

# Claude Code local settings ########
.claude/

# Playwright MCP / DFM live-upload temp artifacts ########
# anchored + global pair (bare `.playwright-mcp/` proved ineffective)
/.playwright-mcp/
**/.playwright-mcp/

# KiCad netlist exports (temporary, derived from .kicad_sch via kicad-cli)
*.net

# Freerouting tool (downloaded locally by user, not redistributable)
freerouting.jar
hardware/kicad/freerouting.jar
