# OS specific ########
.DS_Store
Thumbs.db
desktop.ini

# secrets ########
**/secrets.yaml

# build artifacts ########
**/build/
**/.cache/
**/__pycache__/
*.bak

# third-party submodule build/cache (rotation corrections, etc.)
hardware/kicad/third_party/*/__pycache__/
hardware/kicad/third_party/*/**/__pycache__/

# Temp / scratch directories (auto-downloaded models, cached binaries:
# .tmp/spice/ for ngspice + LM2596 PSpice model, .tmp/freerouting/ for
# Freerouting JAR when a routing rework is needed).
/.tmp/

# Audit netlist exports (temporary; regenerable via kicad-cli sch export netlist)
hardware/kicad/_tmp_audit.net
hardware/kicad/_audit_*.net

# Stale agent / autorouter cleanup artefacts (historic local-only files)
hardware/renders/_freerouting_*.log
hardware/renders/_sch-*-tmp/

# KiCad ########
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.kicad_prl
fp-info-cache
~*.lck
_autosave-*

# KiCad MCP-tool backups (timestamped safety copies)
hardware/kicad/.mcp-backups/

# Local KiCad reports/exports (regenerable, not source-of-truth)
hardware/kicad/drc.json
hardware/kicad/erc.json
hardware/kicad/*.svg
hardware/kicad/*.pdf
hardware/kicad/*.rpt

# Freerouting intermediate artifacts (DSN export → autorouter → SES import roundtrip)
hardware/kicad/*.dsn
hardware/kicad/*.ses
hardware/kicad/oas_drc_violations.json
# Inside renders/: PNGs and SVGs are committed as visual changelog,
# but DRC/ERC text reports (prefixed `_`) are not.
hardware/renders/_*
hardware/renders/*.log

# Production deliverables (hardware/output/) — regenerable from generate.py
# via `python regenerate.py`. Individual gerbers / drill / drill_map / gbrjob
# are gitignored (day-to-day regenerations should not flood git diff). The
# JLCPCB-ready ZIP + BOM CSV + pos CSVs are COMMITTED as a snapshot of the
# current revision (visible to reviewers).
hardware/output/*.gtl
hardware/output/*.gbl
hardware/output/*.gts
hardware/output/*.gbs
hardware/output/*.gto
hardware/output/*.gbo
hardware/output/*.gtp
hardware/output/*.gbp
hardware/output/*.gm1
hardware/output/*.gbrjob
hardware/output/*.drl
hardware/output/*-drl_map.pdf

# ESPHome ########
.esphome/
firmware/esphome/.esphome/

# Editors ########
.vscode/
.idea/
.history/
*.swp
*~

# Playwright MCP / DFM live-upload temp artifacts ########
# anchored + global pair (bare `.playwright-mcp/` proved ineffective)
/.playwright-mcp/
**/.playwright-mcp/
*.kicad_pcb.tmp
*.kicad_pro.tmp

# Screenshots, scratch ########
Zrzut*.png
# widened from screenshot*.png — catches suffix patterns (botland-...-screenshot.png etc.)
*screenshot*.png
# session scratch renders + previews
led-preview*.png
*-preview*.png
*.scratch

# KiCad netlist exports (temporary, derived from .kicad_sch via kicad-cli)
*.net
_tmp_netlist_audit.net
_audit_*.net

# Freerouting tool (downloaded locally by user, not redistributable)
freerouting.jar
hardware/kicad/freerouting.jar
hardware/kicad/freerouting.json
hardware/kicad/freerouting.log

